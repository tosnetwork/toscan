# Browser-facing JSON-RPC endpoint. In development, Vite proxies /jsonRPC.
VITE_TOS_RPC_URL=/jsonRPC
VITE_TOS_RPC_TRANSPORT=json-rpc
VITE_TOS_NETWORK=mainnet
VITE_TOS_RPC_TIMEOUT_MS=2500

# Read-only tosctld API or an authenticated reverse proxy in front of it.
VITE_TOS_SERVICE_API_URL=/tos-service-api

# Development proxy targets (never exposed in the browser bundle).
TOS_RPC_PROXY_TARGET=http://127.0.0.1:8011
TOS_SERVICE_PROXY_TARGET=http://127.0.0.1:8080

# If true, an unavailable backend falls back to clearly labelled preview data.
VITE_ENABLE_PREVIEW=true

# Production container reverse-proxy settings. Never expose the API key as VITE_*.
TOS_RPC_UPSTREAM=http://host.docker.internal:8011
TOS_RPC_API_KEY=
TOS_SERVICE_UPSTREAM=http://host.docker.internal:8080

# Production query projection. SQLite remains the node-local recovery index;
# this PostgreSQL projection serves scalable public search and pagination.
POSTGRES_USER=toscan
POSTGRES_PASSWORD=toscan-local-only
POSTGRES_DB=toscan
POSTGRES_PORT=55432
TOS_SOURCE_EXPLORER=http://host.docker.internal:8080
QUERY_PROJECT_BATCH=64
QUERY_READY_MAX_LAG=2
QUERY_READY_MAX_STALE_SECONDS=30
QUERY_ASSET_SCAN_BATCH=16
