# Browser-facing JSON-RPC endpoint. In development, Vite proxies /jsonRPC.
VITE_TOS_RPC_URL=/jsonRPC
VITE_TOS_NETWORK=mainnet
VITE_TOS_RPC_TIMEOUT_MS=2500

# Read-only tosctld API or an authenticated reverse proxy in front of it.
VITE_TOS_SERVICE_API_URL=/tos-service-api

# Development proxy targets (never exposed in the browser bundle).
TOS_RPC_PROXY_TARGET=http://127.0.0.1:8011
TOS_SERVICE_PROXY_TARGET=http://127.0.0.1:8080

# If true, an unavailable backend falls back to clearly labelled preview data.
VITE_ENABLE_PREVIEW=true
