{
  "name": "@tosnetwork/toscan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The official explorer for TOS Network",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --pretty false",
    "query:typecheck": "tsc -p services/query/tsconfig.json --noEmit",
    "query:build": "tsc -p services/query/tsconfig.json",
    "query:dev": "tsx watch services/query/src/main.ts",
    "query:start": "node services/query/dist/main.js",
    "verification:import": "tsx scripts/import-contract-verification.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:query:integration": "vitest run services/query/src/db.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:real-chain": "playwright test --config playwright.real-chain.config.ts",
    "stack:up": "python3 scripts/dev-stack.py up",
    "stack:stop": "python3 scripts/dev-stack.py stop",
    "stack:status": "python3 scripts/dev-stack.py status",
    "stack:seed": "python3 scripts/dev-stack.py seed",
    "stack:reset": "python3 scripts/dev-stack.py reset --yes",
    "stack:logs": "python3 scripts/dev-stack.py logs",
    "check": "pnpm lint && pnpm typecheck && pnpm query:typecheck && pnpm test && pnpm build && pnpm query:build"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "pg": "^8.16.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.33.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.6"
  }
}
